# LLM Configuration
# Models: gemini-3.8-flash, nvidia/llama-3.1-nemotron-70b-instruct, gemini-2.0-flash, gpt-4o, gpt-4o-mini, claude-3-5-sonnet
PRIMARY_MODEL=gemini-3.8-flash
FALLBACK_MODEL=gemini-3.8-flash
NVIDIA_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Replay & Deterministic Execution
# Set REPLAY=1 for zero-network cache-only execution
REPLAY=0
REPLAY_CACHE_DB=eval/replay_cache.sqlite
INCIDENT_MEMORY_DB=eval/incident_memory.sqlite

# API & Dashboard Server
APP_HOST=0.0.0.0
APP_PORT=8000

# Docker & Environment
DOCKER_HOST=
